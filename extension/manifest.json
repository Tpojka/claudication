{
  "manifest_version": 3,
  "name": "Claudication",
  "version": "2.0.0",
  "description": "Toolbar knee that hurts while Claude Code is working and relaxes when Claude is ready.",
  "key": "",
  "permissions": ["nativeMessaging", "alarms"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Claudication: connecting…",
    "default_icon": {
      "16": "icons/knee-unknown-16.png",
      "32": "icons/knee-unknown-32.png",
      "48": "icons/knee-unknown-48.png",
      "128": "icons/knee-unknown-128.png"
    }
  },
  "icons": {
    "16": "icons/knee-ok-16.png",
    "32": "icons/knee-ok-32.png",
    "48": "icons/knee-ok-48.png",
    "128": "icons/knee-ok-128.png"
  }
}
